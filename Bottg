# БАЗА ДАННЫХ (JSON)
# ============================================================
def init_db():
    if not os.path.exists(DB_FILE):
        save_db({
            "users": [],
            "numbers": {"США": [], "Мьянма": [], "Колумбия": [], "Индия": []},
        })


def load_db():
    with open(DB_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def add_user(user_id: int):
    data = load_db()
    if user_id not in data["users"]:
        data["users"].append(user_id)
        save_db(data)


def add_number(country: str, number: str):
    data = load_db()
    data["numbers"].setdefault(country, []).append(number)
    save_db(data)


def take_number(country: str):
    data = load_db()
    nums = data["numbers"].get(country, [])
    if not nums:
        return None
    num = nums.pop(0)
    save_db(data)
    return num


def get_count(country: str) -> int:
    data = load_db()
    return len(data["numbers"].get(country, []))


