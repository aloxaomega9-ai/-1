@router.message(F.from_user.id == ADMIN_ID, F.text)
async def admin_catch_all(message: Message, bot: Bot, state: FSMContext):
    current = await state.get_state()
    if current is not None:
        return
    if message.text.startswith("/"):
        return
    if not pending_code_requests:
        return

    req = pending_code_requests.pop(0)
    try:
        await bot.send_message(
            req["user_id"],
            f"📩 Код для номера {req['number']}:\n\n"
            f"🔑 {message.text}\n\n"
            f"Если код не подошёл — нажмите «📩 Получить код» ещё раз.",
        )
        remaining = len(pending_code_requests)
        await message.answer(
            f"✅ Код переслан покупателю *{req['user_name']}* "
            f"(ID: `{req['user_id']}`).\n"
            f"📊 Осталось запросов в очереди: {remaining}",
            parse_mode="Markdown",
        )
    except Exception as e:
        await message.answer(f"❌ Ошибка отправки покупателю: {e}")


