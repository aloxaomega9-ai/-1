def init_db():
    if not os.path.exists(DB_FILE):
        save_db({
            "users": [],
            "numbers": {"США": [], "Мьянма": [], "Колумбия": [], "Индия": []},
        })


def load_db():
    with open(DB_FILE, "r", encoding="utf-8") as f:
        data = json.load(f)
    data.setdefault("users", [])
    data.setdefault("numbers", {})
    data.setdefault("orders", [])
    data.setdefault("blacklist", [])
    data.setdefault("prices", {})
    return data


# ---- Цены ----
def load_prices():
    PRICES.update(load_db().get("prices", {}))


def set_price(country: str, price: int):
    PRICES[country] = price
    data = load_db()
    data["prices"] = dict(PRICES)
    save_db(data)


# ---- Заказы ----
def add_order(user_id, user_name, username, country, price, number, status):
    data = load_db()
    order = {
        "id": len(data["orders"]) + 1,
        "user_id": user_id,
        "user_name": user_name,
        "username": username,
        "country": country,
        "price": price,
        "number": number,
        "status": status,  # "выдан" или "отклонён"
        "created_at": datetime.now(TZ).strftime("%d.%m.%Y %H:%M"),
    }
    data["orders"].append(order)
    save_db(data)
    return order


# ---- Номера ----
def delete_number(country: str, number: str) -> bool:
    data = load_db()
    nums = data["numbers"].get(country, [])
    if number in nums:
        nums.remove(number)
        save_db(data)
        return True
    return False


# ---- Чёрный список ----
def is_blacklisted(user_id: int) -> bool:
    return user_id in load_db()["blacklist"]


def add_blacklist(user_id: int):
    data = load_db()
    if user_id not in data["blacklist"]:
        data["blacklist"].append(user_id)
        save_db(data)


def remove_blacklist(user_id: int):
    data = load_db()
    if user_id in data["blacklist"]:
        data["blacklist"].remove(user_id)
        save_db(data)


async def get_user_info(bot: Bot, user_id: int):
    try:
        chat = await bot.get_chat(user_id)
        return chat.full_name, (f"@{chat.username}" if chat.username else "нет")
    except Exception:
        return "Неизвестно", "нет"


def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def add_user(user_id: int):
    data = load_db()
    if user_id not in data["users"]:
        data["users"].append(user_id)
        save_db(data)


def add_number(country: str, number: str):
    data = load_db()
    data["numbers"].setdefault(country, []).append(number)
    save_db(data)


def take_number(country: str):
    data = load_db()
    nums = data["numbers"].get(country, [])
    if not nums:
        return None
    num = nums.pop(0)
    save_db(data)
    return num


def get_count(country: str) -> int:
    data = load_db()
    return len(data["numbers"].get(country, []))


